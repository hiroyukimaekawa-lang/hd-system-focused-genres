{
  "manifest_version": 3,
  "name": "【限定版】HD 食べログ 6ジャンル",
  "short_name": "HD 食べログ 6ジャンル",
  "version": "4.2.0",
  "description": "食べログから飲食6ジャンルの店舗情報を取得してCSVダウンロード",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "notifications",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://tabelog.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tabelog.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/xlsx.full.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "【限定版】HD 食べログ 6ジャンル",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
